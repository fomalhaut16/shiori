# .env にコピーして値を埋める。.env は git に入れない。

# App-Level Token（スコープ connections:write）。xapp- で始まる
SLACK_APP_TOKEN=xapp-
# Bot User OAuth Token。xoxb- で始まる
SLACK_BOT_TOKEN=xoxb-
# 操作を受け付ける Slack のメンバー ID（U で始まる）。複数ならカンマ区切り
ALLOWED_USER_IDS=U

# 定期通知の送り先。チャンネル ID（C で始まる）か、メンバー ID（DM になる）
# 空なら ALLOWED_USER_IDS の先頭の人への DM
NOTIFY_CHANNEL=

# 定期通知の時刻（日本時間の時）と週報の曜日（0 = 日曜）
NOTIFY_HOUR=21
WEEKLY_DAY=0
# この日数ページが進んでいない本を催促する
STALL_DAYS=3

# 置き場所（相対パスはこのフォルダから）
# DB_PATH=data/shiori.db
# BACKUP_DIR=data/backups
# LOG_PATH=data/shiori.log
# KEEP_BACKUPS=30
